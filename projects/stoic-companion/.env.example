# Offline demo defaults. Copy to .env; never commit .env.
DEMO_MODE=true
EMBEDDING_PROVIDER=demo
# Guest authentication is independent from inference. Use openai here for real GPT with local guest access.
GENERATION_PROVIDER=auto
CORPUS_VERSION=v1
VECTOR_NAMESPACE=
# Optional shared model-specific cache for benchmark runs; never shared with another embedding model.
# EMBEDDING_CACHE_DIR=/workspace/backend/data/embeddings
CHUNK_STRATEGY=structure
RETRIEVAL_MODE=hybrid
RERANK=true
DEBUG_ENABLED=true
OPENAI_API_KEY=
CHAT_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
ADMIN_TOKEN=
MONTHLY_BUDGET_USD=10
MAX_OUTPUT_TOKENS=1600
REQUESTS_PER_MINUTE=12
GUEST_MESSAGE_LIMIT=30
# Pricing inputs are estimates; set according to your provider contract.
INPUT_USD_PER_MILLION=1.0
OUTPUT_USD_PER_MILLION=5.0
EMBEDDING_USD_PER_MILLION=0.02
CORS_ORIGIN=http://localhost:3000
# Native defaults: SQLite + on-disk Qdrant. Compose overrides these.
# DATABASE_URL=postgresql+psycopg://stoic:YOUR_PASSWORD@localhost:5432/stoic
# QDRANT_URL=http://localhost:6333
# Used only by Compose; supply your own local password.
POSTGRES_PASSWORD=
# Auth0 SPA: public config is safe; these are NOT client secrets.
NEXT_PUBLIC_AUTH0_DOMAIN=
NEXT_PUBLIC_AUTH0_CLIENT_ID=
NEXT_PUBLIC_AUTH0_AUDIENCE=
